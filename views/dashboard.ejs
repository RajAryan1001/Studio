<div class="card">
    <h1>Dashboard Overview</h1>
    
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-number"><%= studioCount || 0 %></div>
            <p>Studio</p>
        </div>
        <div class="stat-card">
            <div class="stat-number"><%= artistCount || 0 %></div>
            <p>Artists</p>
        </div>
        <div class="stat-card">
            <div class="stat-number"><%= assetCount || 0 %></div>
            <p>Assets</p>
        </div>
        <div class="stat-card">
            <div class="stat-number"><%= checklistProgress %>%</div>
            <p>Progress</p>
        </div>
    </div>
</div>

<div class="card">
    <h2>Setup Progress</h2>
    <div style="background: #eee; height: 10px; border-radius: 5px; margin: 20px 0;">
        <div style="background: #3498db; height: 100%; width: <%= checklistProgress %>%; border-radius: 5px;"></div>
    </div>
    
    <div style="display: grid; gap: 15px;">
        <div style="display: flex; align-items: center; gap: 15px; padding: 15px; background: <%= studioCount ? '#e8f6ef' : '#f5f5f5' %>; border-radius: 5px;">
            <div style="width: 30px; height: 30px; background: <%= studioCount ? '#2ecc71' : '#ccc' %>; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                <%= studioCount ? '✓' : '1' %>
            </div>
            <div style="flex: 1;">
                <h3>Studio Information</h3>
                <p>Setup your studio name, location, and specialties</p>
            </div>
            <a href="/studio" class="btn <%= studioCount ? 'btn-success' : '' %>">
                <%= studioCount ? 'Update' : 'Setup' %>
            </a>
        </div>
        
        <div style="display: flex; align-items: center; gap: 15px; padding: 15px; background: <%= artistCount ? '#e8f6ef' : '#f5f5f5' %>; border-radius: 5px;">
            <div style="width: 30px; height: 30px; background: <%= artistCount ? '#2ecc71' : '#ccc' %>; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                <%= artistCount ? '✓' : '2' %>
            </div>
            <div style="flex: 1;">
                <h3>Add Artists</h3>
                <p>Register your tattoo artists with their specialties</p>
            </div>
            <a href="/artists" class="btn <%= artistCount ? 'btn-success' : '' %>">
                <%= artistCount ? 'Manage' : 'Add' %>
            </a>
        </div>
        
        <div style="display: flex; align-items: center; gap: 15px; padding: 15px; background: <%= assetCount ? '#e8f6ef' : '#f5f5f5' %>; border-radius: 5px;">
            <div style="width: 30px; height: 30px; background: <%= assetCount ? '#2ecc71' : '#ccc' %>; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                <%= assetCount ? '✓' : '3' %>
            </div>
            <div style="flex: 1;">
                <h3>Upload Portfolio</h3>
                <p>Add images and videos of your best work</p>
            </div>
            <a href="/assets" class="btn <%= assetCount ? 'btn-success' : '' %>">
                <%= assetCount ? 'View' : 'Upload' %>
            </a>
        </div>
    </div>
</div>