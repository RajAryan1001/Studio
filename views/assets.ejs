<div class="card assets-container">
    <!-- Header -->
    <div class="assets-header">
        <h1 class="assets-title">
            <i class="fas fa-images"></i> Portfolio Assets
        </h1>
        <p class="assets-subtitle">Upload and manage your tattoo portfolio</p>
    </div>
    
    <!-- Stats -->
    <div class="assets-stats">
        <div class="stat-box">
            <div class="stat-icon">
                <i class="fas fa-images"></i>
            </div>
            <div class="stat-content">
                <div class="stat-number">
                    <% if (assets) { %>
                        <%= assets.filter(a => a.type === 'image').length %>
                    <% } else { %>
                        0
                    <% } %>
                </div>
                <div class="stat-label">Images</div>
            </div>
        </div>
        
        <div class="stat-box">
            <div class="stat-icon">
                <i class="fas fa-video"></i>
            </div>
            <div class="stat-content">
                <div class="stat-number">
                    <% if (assets) { %>
                        <%= assets.filter(a => a.type === 'video').length %>
                    <% } else { %>
                        0
                    <% } %>
                </div>
                <div class="stat-label">Videos</div>
            </div>
        </div>
        
        <div class="stat-box">
            <div class="stat-icon">
                <i class="fas fa-cloud-upload-alt"></i>
            </div>
            <div class="stat-content">
                <div class="stat-number">
                    <% if (assets) { %>
                        <%= assets.length %>
                    <% } else { %>
                        0
                    <% } %>
                </div>
                <div class="stat-label">Total</div>
            </div>
        </div>
    </div>
    
    <!-- Upload Section -->
    <div class="upload-section">
        <div class="upload-header">
            <h2><i class="fas fa-cloud-upload-alt"></i> Upload New Asset</h2>
            <p>Showcase your best tattoo work with high-quality media</p>
        </div>
        
        <form action="/assets/upload" method="POST" enctype="multipart/form-data" class="upload-form" id="uploadForm">
            <div class="upload-area" id="dropArea">
                <div class="upload-icon">
                    <i class="fas fa-file-upload"></i>
                </div>
                <div class="upload-text">
                    <h3>Drag & Drop or Click to Browse</h3>
                    <p>Supports images (JPEG, PNG) and videos (MP4, MOV)</p>
                </div>
                <input type="file" 
                       name="asset" 
                       accept="image/*,video/*" 
                       required
                       class="file-input"
                       id="fileInput"
                       onchange="previewFile()">
                <label for="fileInput" class="browse-btn">Browse Files</label>
            </div>
            
            <!-- File Preview -->
            <div class="file-preview" id="filePreview">
                <div class="preview-placeholder">
                    <i class="fas fa-image"></i>
                    <p>File preview will appear here</p>
                </div>
            </div>
            
            <!-- File Info -->
            <div class="file-info">
                <div class="info-item">
                    <i class="fas fa-info-circle"></i>
                    <span>Images are auto-optimized for web</span>
                </div>
                <div class="info-item">
                    <i class="fas fa-info-circle"></i>
                    <span>Videos should be under 100MB</span>
                </div>
                <div class="info-item">
                    <i class="fas fa-info-circle"></i>
                    <span>Upload high-quality files for best results</span>
                </div>
            </div>
            
            <!-- Submit Button -->
            <div class="upload-actions">
                <button type="submit" class="upload-btn" id="uploadBtn">
                    <i class="fas fa-upload"></i> Upload Asset
                </button>
                <button type="button" class="clear-btn" onclick="clearFile()">
                    <i class="fas fa-times"></i> Clear
                </button>
            </div>
        </form>
    </div>
    
    <!-- Assets Gallery -->
    <% if (assets && assets.length > 0) { %>
        <div class="gallery-section">
            <div class="gallery-header">
                <h2><i class="fas fa-photo-video"></i> Portfolio Gallery (<%= assets.length %>)</h2>
                <div class="filter-buttons">
                    <button class="filter-btn active" onclick="filterAssets('all')">All</button>
                    <button class="filter-btn" onclick="filterAssets('image')">
                        <i class="fas fa-image"></i> Images
                    </button>
                    <button class="filter-btn" onclick="filterAssets('video')">
                        <i class="fas fa-video"></i> Videos
                    </button>
                </div>
            </div>
            
            <div class="assets-grid" id="assetsGrid">
                <% assets.forEach(asset => { %>
                    <div class="asset-card" data-type="<%= asset.type %>">
                        <!-- Media -->
                        <div class="asset-media">
                            <% if (asset.type === 'image') { %>
                                <img src="/<%= asset.optimizedPath || asset.originalPath %>" 
                                     alt="Portfolio"
                                     class="asset-image">
                                <div class="asset-badge image-badge">
                                    <i class="fas fa-image"></i> Image
                                </div>
                            <% } else { %>
                                <div class="video-container">
                                    <video class="asset-video">
                                        <source src="/<%= asset.optimizedPath || asset.originalPath %>">
                                    </video>
                                    <div class="video-overlay" onclick="togglePlay(this)">
                                        <i class="fas fa-play"></i>
                                    </div>
                                </div>
                                <div class="asset-badge video-badge">
                                    <i class="fas fa-video"></i> Video
                                </div>
                            <% } %>
                        </div>
                        
                        <!-- Info -->
                        <div class="asset-info">
                            <div class="asset-header">
                                <h3>
                                    <% if (asset.type === 'image') { %>
                                        <i class="fas fa-image"></i>
                                    <% } else { %>
                                        <i class="fas fa-video"></i>
                                    <% } %>
                                    <%= asset.type.charAt(0).toUpperCase() + asset.type.slice(1) %> Asset
                                </h3>
                                <div class="asset-actions">
                                    <a href="/<%= asset.optimizedPath || asset.originalPath %>" 
                                       target="_blank" 
                                       class="view-btn"
                                       title="View Full Size">
                                        <i class="fas fa-external-link-alt"></i>
                                    </a>
                                    <form action="/assets/<%= asset._id %>/delete" 
                                          method="POST"
                                          onsubmit="return confirmDelete()">
                                        <button type="submit" class="delete-btn" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                            
                            <div class="asset-details">
                                <div class="detail">
                                    <i class="fas fa-calendar"></i>
                                    <span><%= new Date(asset.createdAt || Date.now()).toLocaleDateString() %></span>
                                </div>
                                <div class="detail">
                                    <i class="fas fa-file"></i>
                                    <span><%= asset.originalPath.split('/').pop() %></span>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    <% } else { %>
        <!-- Empty State -->
        <div class="empty-state">
            <div class="empty-icon">
                <i class="fas fa-images"></i>
            </div>
            <h3>No Portfolio Assets Yet</h3>
            <p>Upload images and videos of your best tattoo work to showcase your skills.</p>
            <button onclick="scrollToUpload()" class="upload-first-btn">
                <i class="fas fa-plus"></i> Upload First Asset
            </button>
        </div>
    <% } %>
    
    <!-- Tips Section -->
    <div class="tips-section">
        <div class="tips-header">
            <i class="fas fa-lightbulb"></i>
            <h3>Upload Tips</h3>
        </div>
        <div class="tips-grid">
            <div class="tip">
                <i class="fas fa-check-circle"></i>
                <h4>Image Quality</h4>
                <p>Use high-resolution images (min 1200px width)</p>
            </div>
            <div class="tip">
                <i class="fas fa-check-circle"></i>
                <h4>Video Size</h4>
                <p>Keep videos under 100MB for faster loading</p>
            </div>
            <div class="tip">
                <i class="fas fa-check-circle"></i>
                <h4>File Formats</h4>
                <p>Use JPEG/PNG for images, MP4 for videos</p>
            </div>
            <div class="tip">
                <i class="fas fa-check-circle"></i>
                <h4>Optimization</h4>
                <p>Images are auto-optimized for web viewing</p>
            </div>
        </div>
    </div>
</div>

