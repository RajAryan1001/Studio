</style>

<!-- JavaScript -->
<script>
    // File preview
    function previewFile() {
        const input = document.getElementById('fileInput');
        const preview = document.getElementById('filePreview');
        const file = input.files[0];
        
        if (!file) return;
        
        const reader = new FileReader();
        reader.onload = function(e) {
            preview.innerHTML = '';
            
            if (file.type.startsWith('image/')) {
                const img = document.createElement('img');
                img.src = e.target.result;
                img.className = 'preview-image';
                preview.appendChild(img);
            } else if (file.type.startsWith('video/')) {
                const video = document.createElement('video');
                video.src = e.target.result;
                video.controls = true;
                video.className = 'preview-video';
                preview.appendChild(video);
            } else {
                preview.innerHTML = `
                    <div class="preview-placeholder">
                        <i class="fas fa-file"></i>
                        <p>${file.name}</p>
                        <p>(${(file.size / 1024 / 1024).toFixed(2)} MB)</p>
                    </div>
                `;
            }
        };
        
        reader.readAsDataURL(file);
        updateUploadButton(file);
    }
    
    // Clear file
    function clearFile() {
        document.getElementById('fileInput').value = '';
        document.getElementById('filePreview').innerHTML = `
            <div class="preview-placeholder">
                <i class="fas fa-image"></i>
                <p>File preview will appear here</p>
            </div>
        `;
        document.getElementById('uploadBtn').innerHTML = '<i class="fas fa-upload"></i> Upload Asset';
    }
    
    // Update upload button text
    function updateUploadButton(file) {
        const btn = document.getElementById('uploadBtn');
        if (file) {
            btn.innerHTML = `<i class="fas fa-upload"></i> Upload "${file.name}"`;
        }
    }
    
    // Drag and drop
    const dropArea = document.getElementById('dropArea');
    const fileInput = document.getElementById('fileInput');
    
    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
        dropArea.addEventListener(eventName, preventDefaults, false);
    });
    
    function preventDefaults(e) {
        e.preventDefault();
        e.stopPropagation();
    }
    
    ['dragenter', 'dragover'].forEach(eventName => {
        dropArea.addEventListener(eventName, highlight, false);
    });
    
    ['dragleave', 'drop'].forEach(eventName => {
        dropArea.addEventListener(eventName, unhighlight, false);
    });
    
    function highlight() {
        dropArea.classList.add('drag-over');
    }
    
    function unhighlight() {
        dropArea.classList.remove('drag-over');
    }
    
    dropArea.addEventListener('drop', handleDrop, false);
    
    function handleDrop(e) {
        const dt = e.dataTransfer;
        const files = dt.files;
        
        if (files.length > 0) {
            fileInput.files = files;
            previewFile();
        }
    }
    
    // Filter assets
    function filterAssets(type) {
        const assets = document.querySelectorAll('.asset-card');
        const buttons = document.querySelectorAll('.filter-btn');
        
        // Update active button
        buttons.forEach(btn => {
            const btnType = btn.getAttribute('onclick')?.includes("'") ? 
                           btn.getAttribute('onclick').split("'")[1] : 'all';
            if (btnType === type) {
                btn.classList.add('active');
            } else {
                btn.classList.remove('active');
            }
        });
        
        // Filter assets
        assets.forEach(asset => {
            if (type === 'all' || asset.dataset.type === type) {
                asset.style.display = 'block';
                setTimeout(() => {
                    asset.style.opacity = '1';
                    asset.style.transform = 'scale(1)';
                }, 10);
            } else {
                asset.style.opacity = '0';
                asset.style.transform = 'scale(0.9)';
                setTimeout(() => {
                    asset.style.display = 'none';
                }, 300);
            }
        });
    }
    
    // Toggle video play
    function togglePlay(element) {
        const video = element.parentElement.querySelector('.asset-video');
        const icon = element.querySelector('i');
        
        if (video.paused) {
            video.play();
            icon.className = 'fas fa-pause';
        } else {
            video.pause();
            icon.className = 'fas fa-play';
        }
    }
    
    // Confirm delete
    function confirmDelete() {
        return confirm('Are you sure you want to delete this asset?');
    }
    
    // Scroll to upload
    function scrollToUpload() {
        document.querySelector('.upload-section').scrollIntoView({ 
            behavior: 'smooth' 
        });
    }
    
    // Show upload progress
    document.getElementById('uploadForm').addEventListener('submit', function(e) {
        const btn = document.getElementById('uploadBtn');
        const originalText = btn.innerHTML;
        
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Uploading...';
        btn.disabled = true;
        
        // Re-enable after 5 seconds if still on page
        setTimeout(() => {
            btn.innerHTML = originalText;
            btn.disabled = false;
        }, 5000);
    });
</script>

