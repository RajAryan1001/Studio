        border-radius: 8px;
        padding: 25px;
        border: 1px solid #e0f2fe;
    }
    
    .info-card-header {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 1px solid #f0f9ff;
    }
    
    .info-card-header i {
        font-size: 1.8rem;
        color: #0369a1;
    }
    
    .info-card-header h3 {
        color: #0c4a6e;
        font-size: 1.3rem;
