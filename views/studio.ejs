        flex-wrap: wrap;
        gap: 10px;
        margin: 15px 0;
    }
    
    .specialty-badge {
        background: #dbeafe;
        color: #1d4ed8;
        padding: 8px 15px;
        border-radius: 20px;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    
    .info-footer {
        margin-top: 20px;
        padding-top: 15px;
        border-top: 1px solid #f0f9ff;
        color: #64748b;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    
    /* Action Buttons */
    .action-buttons {
        display: flex;
        gap: 15px;
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid #d1e9ff;
    }
    
    .action-btn {
        padding: 12px 25px;
        border-radius: 6px;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        transition: all 0.3s;
        border: none;
    }
    
    .copy-btn {
        background: #3b82f6;
        color: white;
    }
    
    .copy-btn:hover {
        background: #2563eb;
        transform: translateY(-2px);
    }
    
    .share-btn {
        background: #8b5cf6;
        color: white;
    }
    
    .share-btn:hover {
        background: #7c3aed;
        transform: translateY(-2px);
    }
    
    .home-btn {
        background: #6b7280;
        color: white;
    }
    
    .home-btn:hover {
        background: #4b5563;
        transform: translateY(-2px);
    }
    
    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 60px 30px;
        background: #f8fafc;
        border-radius: 10px;
        border: 2px dashed #cbd5e1;
    }
    
    .empty-icon {
        font-size: 4rem;
        color: #cbd5e1;
        margin-bottom: 20px;
    }
    
    .empty-state h3 {
        color: #64748b;
        margin-bottom: 15px;
    }
    
    .empty-state p {
        color: #94a3b8;
        max-width: 400px;
        margin: 0 auto 30px;
    }
    
    .setup-btn {
        background: #3498db;
        color: white;
        border: none;
        padding: 15px 30px;
        border-radius: 6px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        transition: all 0.3s;
