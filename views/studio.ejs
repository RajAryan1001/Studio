<div class="card studio-container">
    <!-- Header -->
    <div class="studio-header">
        <h1 class="studio-title">
            <i class="fas fa-store"></i> Studio Profile
        </h1>
        <p class="studio-subtitle">Manage your tattoo studio information</p>
    </div>
    
    <!-- Form Section -->
    <div class="form-section">
        <div class="form-header">
            <h2><i class="fas fa-edit"></i> Edit Studio Details</h2>
            <p>Update your studio information below</p>
        </div>
        
        <form action="/studio" method="POST" class="studio-form">
            <!-- Studio Name -->
            <div class="form-card">
                <div class="form-card-header">
                    <div class="form-card-icon">
                        <i class="fas fa-signature"></i>
                    </div>
                    <div>
                        <h3>Studio Name</h3>
                        <p>Your studio's public identity</p>
                    </div>
                </div>
                <div class="form-group">
                    <label><i class="fas fa-asterisk"></i> Studio Name *</label>
                    <input type="text" 
                           name="name" 
                           value="<%= studio ? studio.name : '' %>" 
                           placeholder="e.g., InkSesh Tattoo Studio"
                           required
                           class="form-input">
                </div>
            </div>
            
            <!-- Location -->
            <div class="form-card">
                <div class="form-card-header">
                    <div class="form-card-icon">
                        <i class="fas fa-map-marker-alt"></i>
                    </div>
                    <div>
                        <h3>Studio Location</h3>
                        <p>Where clients can find you</p>
                    </div>
                </div>
                <div class="form-group">
                    <label><i class="fas fa-asterisk"></i> Location *</label>
                    <input type="text" 
                           name="location" 
                           value="<%= studio ? studio.location : '' %>" 
                           placeholder="e.g., Connaught Place, Delhi"
                           required
                           class="form-input">
                </div>
            </div>
            
            <!-- Specialties -->
            <div class="form-card">
                <div class="form-card-header">
                    <div class="form-card-icon">
                        <i class="fas fa-star"></i>
                    </div>
                    <div>
                        <h3>Tattoo Specialties</h3>
                        <p>What your studio is known for</p>
                    </div>
                </div>
                <div class="form-group">
                    <label><i class="fas fa-paint-brush"></i> Specialties</label>
                    <input type="text" 
                           name="specialties" 
                           value="<%= studio && studio.specialties ? studio.specialties.join(', ') : '' %>"
                           placeholder="e.g., Realism, Traditional, Blackwork, Japanese"
                           class="form-input">
                    <div class="specialty-tags">
                        <span class="tag" onclick="addSpecialty('Realism')">Realism</span>
                        <span class="tag" onclick="addSpecialty('Traditional')">Traditional</span>
                        <span class="tag" onclick="addSpecialty('Blackwork')">Blackwork</span>
                        <span class="tag" onclick="addSpecialty('Japanese')">Japanese</span>
                        <span class="tag" onclick="addSpecialty('Geometric')">Geometric</span>
                        <span class="tag" onclick="addSpecialty('Watercolor')">Watercolor</span>
                    </div>
                    <p class="form-hint">Click tags to add specialties. Separate with commas.</p>
                </div>
            </div>
            
            <!-- Submit Button -->
            <div class="form-actions">
                <button type="submit" class="submit-btn">
                    <i class="fas fa-save"></i> Save Studio Profile
                </button>
                <button type="button" class="reset-btn" onclick="resetForm()">
                    <i class="fas fa-redo"></i> Reset Form
                </button>
            </div>
        </form>
    </div>
    
    <!-- Current Info -->
    <% if (studio) { %>
        <div class="current-info">
            <div class="current-info-header">
                <h2><i class="fas fa-check-circle"></i> Current Studio Profile</h2>
                <div class="status-badge active">
                    <i class="fas fa-badge-check"></i> Active
                </div>
            </div>
            
            <div class="info-grid">
                <!-- Studio Details -->
                <div class="info-card">
                    <div class="info-card-header">
                        <i class="fas fa-store"></i>
                        <h3>Studio Details</h3>
                    </div>
                    <div class="info-content">
                        <div class="info-item">
                            <span class="info-label">Studio Name:</span>
                            <span class="info-value"><%= studio.name %></span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Location:</span>
                            <span class="info-value"><%= studio.location %></span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Last Updated:</span>
                            <span class="info-value">
                                <%= studio.updatedAt ? new Date(studio.updatedAt).toLocaleDateString() : 'Recently' %>
                            </span>
                        </div>
                    </div>
                </div>
                
                <!-- Specialties -->
                <div class="info-card">
                    <div class="info-card-header">
                        <i class="fas fa-star"></i>
                        <h3>Specialties</h3>
                    </div>
                    <div class="info-content">
                        <div class="specialties-container">
                            <% studio.specialties.forEach(specialty => { %>
                                <span class="specialty-badge">
                                    <i class="fas fa-check"></i> <%= specialty.trim() %>
                                </span>
                            <% }) %>
                        </div>
                        <div class="info-footer">
                            <i class="fas fa-info-circle"></i>
                            <%= studio.specialties.length %> specialty<%= studio.specialties.length > 1 ? 'ies' : '' %> listed
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Actions -->
            <div class="action-buttons">
                <button class="action-btn copy-btn" onclick="copyStudioInfo()">
                    <i class="fas fa-copy"></i> Copy Profile
                </button>
                <button class="action-btn share-btn" onclick="shareStudioInfo()">
                    <i class="fas fa-share-alt"></i> Share
                </button>
                <a href="/home" class="action-btn home-btn">
                    <i class="fas fa-home"></i> Go Home
                </a>
            </div>
        </div>
    <% } else { %>
        <!-- Empty State -->
        <div class="empty-state">
            <div class="empty-icon">
                <i class="fas fa-store-slash"></i>
            </div>
            <h3>Studio Profile Not Setup</h3>
            <p>Setup your studio profile to start managing your tattoo studio.</p>
            <button onclick="scrollToForm()" class="setup-btn">
                <i class="fas fa-plus"></i> Setup Studio Profile
            </button>
        </div>
    <% } %>
</div>

<style>
