        align-items: center;
        gap: 15px;
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 1px solid #f0f0f0;
    }
    
    .form-card-icon {
        width: 50px;
        height: 50px;
        background: #3498db;
        color: white;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }
    
    .form-card-header h3 {
        color: #2c3e50;
        margin-bottom: 5px;
    }
    
    .form-card-header p {
        color: #7f8c8d;
        font-size: 0.9rem;
    }
    
    /* Form Inputs */
    .form-group {
        margin-bottom: 20px;
    }
    
    .form-group label {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #2c3e50;
        font-weight: 600;
        margin-bottom: 10px;
        font-size: 1rem;
    }
    
    .form-group label i {
        color: #3498db;
    }
    
    .form-input {
        width: 100%;
        padding: 14px;
        border: 2px solid #e0e0e0;
