<div class="card home-container">
    <!-- Hero Section -->
    <div class="hero-section">
        <h1 class="hero-title">Welcome to InkSesh Studio Admin</h1>
        <p class="hero-subtitle">Professional tattoo studio management made simple</p>
    </div>
    
    <!-- Stats Cards -->
    <div class="stats-container">
        <div class="stat-item">
            <div class="stat-icon">
                <i class="fas fa-store"></i>
            </div>
            <div class="stat-number"><%= studioCount || 0 %></div>
            <div class="stat-label">Studio</div>
        </div>
        
        <div class="stat-item">
            <div class="stat-icon">
                <i class="fas fa-users"></i>
            </div>
            <div class="stat-number"><%= artistCount || 0 %></div>
            <div class="stat-label">Artists</div>
        </div>
        
        <div class="stat-item">
            <div class="stat-icon">
                <i class="fas fa-images"></i>
            </div>
            <div class="stat-number"><%= assetCount || 0 %></div>
            <div class="stat-label">Assets</div>
        </div>
    </div>
    
    <!-- Quick Actions -->
    <h2 class="section-title">Quick Actions</h2>
    <div class="actions-grid">
        <div class="action-card studio-card">
            <div class="action-icon">
                <i class="fas fa-store-alt"></i>
            </div>
            <h3>Studio Setup</h3>
            <p>Configure your studio details and specialties</p>
            <a href="/studio" class="action-btn">
                <span>Setup Studio</span>
                <i class="fas fa-arrow-right"></i>
            </a>
        </div>
        
        <div class="action-card artists-card">
            <div class="action-icon">
                <i class="fas fa-user-plus"></i>
            </div>
            <h3>Manage Artists</h3>
            <p>Add and manage your tattoo artists team</p>
            <a href="/artists" class="action-btn">
                <span>View Artists</span>
                <i class="fas fa-arrow-right"></i>
            </a>
        </div>
        
        <div class="action-card assets-card">
            <div class="action-icon">
                <i class="fas fa-cloud-upload-alt"></i>
            </div>
            <h3>Upload Portfolio</h3>
            <p>Showcase your work with images and videos</p>
            <a href="/assets" class="action-btn">
                <span>Upload Assets</span>
                <i class="fas fa-arrow-right"></i>
            </a>
        </div>
    </div>
    
    <!-- Getting Started -->
    <div class="getting-started">
        <h2 class="section-title">Getting Started</h2>
        <div class="steps-container">
            <div class="step">
                <div class="step-number">1</div>
                <div class="step-content">
                    <h4>Setup Studio</h4>
                    <p>Add your studio name, location, and specialties</p>
                </div>
                <a href="/studio" class="step-link">Start →</a>
            </div>
            
            <div class="step">
                <div class="step-number">2</div>
                <div class="step-content">
                    <h4>Add Artists</h4>
                    <p>Register your tattoo artists with their roles</p>
                </div>
                <a href="/artists" class="step-link">Start →</a>
            </div>
            
            <div class="step">
                <div class="step-number">3</div>
                <div class="step-content">
                    <h4>Upload Portfolio</h4>
                    <p>Add images and videos of your best work</p>
                </div>
                <a href="/assets" class="step-link">Start →</a>
            </div>
        </div>
    </div>
</div>

