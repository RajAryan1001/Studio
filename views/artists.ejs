<!-- JavaScript -->
<script>
    // Set up event listeners when page loads
    document.addEventListener('DOMContentLoaded', function() {
        // Specialty suggestion tags
        document.querySelectorAll('.suggestion-tag').forEach(tag => {
            tag.addEventListener('click', function() {
                const role = this.getAttribute('data-role');
                document.getElementById('artistRole').value = role;
                showNotification(`Added: ${role}`);
            });
        });
        
        // Example button
        document.getElementById('exampleBtn').addEventListener('click', function() {
            const examples = [
                { name: "Maya Patel", role: "Mandala & Geometric Specialist" },
                { name: "Carlos Rodriguez", role: "Realism, Portrait Artist" },
                { name: "Aisha Khan", role: "Japanese Traditional, Blackwork" },
                { name: "James Wilson", role: "Watercolor, Neo-Traditional" }
            ];
            
            const randomExample = examples[Math.floor(Math.random() * examples.length)];
            
            document.getElementById('artistName').value = randomExample.name;
            document.getElementById('artistRole').value = randomExample.role;
            
            showNotification(`Example loaded: ${randomExample.name}`);
        });
        
        // Export button
        document.getElementById('exportBtn')?.addEventListener('click', function() {
            exportArtists();
        });
        
        // Form submission feedback
        document.getElementById('artistForm').addEventListener('submit', function(e) {
            const submitBtn = this.querySelector('.submit-btn');
            const originalText = submitBtn.innerHTML;
            
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Adding...';
            submitBtn.disabled = true;
            
            // Re-enable after 3 seconds if still on page
            setTimeout(() => {
                submitBtn.innerHTML = originalText;
                submitBtn.disabled = false;
            }, 3000);
        });
    });
    
    // Export artists function
    function exportArtists() {
        // This would need server-side implementation
        // For now, just show a message
        showNotification('Export feature would download artists list as CSV', 'info');
    }
    
    // Show notification
    function showNotification(message, type = 'success') {
        const notification = document.createElement('div');
        notification.style.cssText = `
            position: fixed;
            top: 20px;
            right: 20px;
            background: ${type === 'error' ? '#ef4444' : type === 'info' ? '#3498db' : '#22c55e'};
            color: white;
            padding: 15px 20px;
            border-radius: 8px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            z-index: 1000;
            animation: slideIn 0.3s ease;
            display: flex;
            align-items: center;
            gap: 10px;
        `;
        notification.innerHTML = `
            <i class="fas fa-${type === 'error' ? 'exclamation-triangle' : type === 'info' ? 'info-circle' : 'check-circle'}"></i>
            <span>${message}</span>
        `;
        
        document.body.appendChild(notification);
        
        setTimeout(() => {
            notification.style.animation = 'slideOut 0.3s ease';
            setTimeout(() => notification.remove(), 300);
        }, 3000);
    }
    
    // Add animation keyframes
    const style = document.createElement('style');
    style.textContent = `
        @keyframes slideIn {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }
        
        @keyframes slideOut {
            from { transform: translateX(0); opacity: 1; }
            to { transform: translateX(100%); opacity: 0; }
        }
        
        /* Animate stat numbers */
        .stat-number {
            animation: countUp 1s ease-out;
        }
        
        @keyframes countUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        /* Animate artist cards on load */
        .artist-card {
            animation: fadeInUp 0.5s ease-out;
            animation-fill-mode: both;
        }
        
        @keyframes fadeInUp {
            from { 
                opacity: 0; 
                transform: translateY(20px); 
            }
            to { 
                opacity: 1; 
                transform: translateY(0); 
            }
        }
        
        /* Stagger animation for multiple cards */
        .artists-grid .artist-card:nth-child(1) { animation-delay: 0.1s; }
        .artists-grid .artist-card:nth-child(2) { animation-delay: 0.2s; }
        .artists-grid .artist-card:nth-child(3) { animation-delay: 0.3s; }
        .artists-grid .artist-card:nth-child(4) { animation-delay: 0.4s; }
        .artists-grid .artist-card:nth-child(5) { animation-delay: 0.5s; }
        .artists-grid .artist-card:nth-child(6) { animation-delay: 0.6s; }
    `;
    document.head.appendChild(style);
</script>

