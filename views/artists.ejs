<div class="card artists-container">
    <!-- Header -->
    <div class="artists-header">
        <h1 class="artists-title">
            <i class="fas fa-users"></i> Manage Artists
        </h1>
        <p class="artists-subtitle">Add and manage your tattoo artist team</p>
    </div>
    
    <!-- Stats -->
    <div class="artists-stats">
        <div class="stat-box">
            <div class="stat-icon">
                <i class="fas fa-users"></i>
            </div>
            <div class="stat-content">
                <div class="stat-number"><%= artists ? artists.length : 0 %></div>
                <div class="stat-label">Total Artists</div>
            </div>
        </div>
        
        <div class="stat-box">
            <div class="stat-icon">
                <i class="fas fa-star"></i>
            </div>
            <div class="stat-content">
                <div class="stat-number">
                    <% if (artists && artists.length > 0) { 
                        let specialties = new Set();
                        artists.forEach(artist => {
                            specialties.add(artist.role);
                        });
                    %>
                        <%= specialties.size %>
                    <% } else { %>
                        0
                    <% } %>
                </div>
                <div class="stat-label">Specialties</div>
            </div>
        </div>
        
        <div class="stat-box">
            <div class="stat-icon">
                <i class="fas fa-plus-circle"></i>
            </div>
            <div class="stat-content">
                <div class="stat-number">Add</div>
                <div class="stat-label">New Artist</div>
            </div>
        </div>
    </div>
    
    <!-- Add Artist Form -->
    <div class="form-section">
        <div class="form-header">
            <h2><i class="fas fa-user-plus"></i> Add New Artist</h2>
            <p>Register a new tattoo artist to your studio team</p>
        </div>
        
        <form action="/artists" method="POST" class="artist-form" id="artistForm">
            <div class="form-grid">
                <!-- Artist Name -->
                <div class="form-card">
                    <div class="form-card-header">
                        <div class="form-card-icon">
                            <i class="fas fa-user"></i>
                        </div>
                        <div>
                            <h3>Artist Details</h3>
                            <p>Basic information about the artist</p>
                        </div>
                    </div>
                    <div class="form-group">
                        <label><i class="fas fa-asterisk"></i> Artist Name *</label>
                        <input type="text" 
                               name="name" 
                               placeholder="e.g., Alex Rodriguez"
                               required
                               class="form-input"
                               id="artistName">
                        <p class="form-hint">Full name of the tattoo artist</p>
                    </div>
                </div>
                
                <!-- Role/Specialty -->
                <div class="form-card">
                    <div class="form-card-header">
                        <div class="form-card-icon">
                            <i class="fas fa-briefcase"></i>
                        </div>
                        <div>
                            <h3>Specialty & Role</h3>
                            <p>Artist's expertise and position</p>
                        </div>
                    </div>
                    <div class="form-group">
                        <label><i class="fas fa-asterisk"></i> Role / Specialty *</label>
                        <input type="text" 
                               name="role" 
                               placeholder="e.g., Realism Specialist, Blackwork Expert"
                               required
                               class="form-input"
                               id="artistRole">
                        <div class="specialty-suggestions">
                            <span class="suggestion-tag" data-role="Realism Specialist">Realism</span>
                            <span class="suggestion-tag" data-role="Traditional Artist">Traditional</span>
                            <span class="suggestion-tag" data-role="Blackwork Expert">Blackwork</span>
                            <span class="suggestion-tag" data-role="Japanese Specialist">Japanese</span>
                            <span class="suggestion-tag" data-role="Portrait Artist">Portrait</span>
                            <span class="suggestion-tag" data-role="Watercolor Artist">Watercolor</span>
                        </div>
                        <p class="form-hint">Click tags above for quick selection</p>
                    </div>
                </div>
            </div>
            
            <!-- Form Actions -->
            <div class="form-actions">
                <button type="submit" class="submit-btn">
                    <i class="fas fa-plus"></i> Add Artist
                </button>
                <button type="button" class="example-btn" id="exampleBtn">
                    <i class="fas fa-lightbulb"></i> Fill Example
                </button>
                <button type="reset" class="clear-btn">
                    <i class="fas fa-times"></i> Clear Form
                </button>
            </div>
        </form>
    </div>
    
    <!-- Artists List -->
    <% if (artists && artists.length > 0) { %>
        <div class="artists-list">
            <div class="list-header">
                <h2><i class="fas fa-users-cog"></i> Artist Team (<%= artists.length %>)</h2>
                <button class="export-btn" id="exportBtn">
                    <i class="fas fa-download"></i> Export List
                </button>
            </div>
            
            <div class="artists-grid">
                <% artists.forEach((artist, index) => { 
                    // Generate avatar color based on index
                    const avatarColors = ['#e74c3c', '#3498db', '#2ecc71', '#f39c12', '#9b59b6', '#1abc9c'];
                    const avatarColor = avatarColors[index % avatarColors.length];
                %>
                    <div class="artist-card">
                        <div class="artist-card-header">
                            <div class="artist-avatar" style="background: <%= avatarColor %>;">
                                <%= artist.name.charAt(0).toUpperCase() %>
                            </div>
                            <div class="artist-info">
                                <h3><%= artist.name %></h3>
                                <p class="artist-role">
                                    <i class="fas fa-briefcase"></i> <%= artist.role %>
                                </p>
                            </div>
                            <% if (index < 2) { %>
                                <span class="senior-badge">
                                    <i class="fas fa-crown"></i> Senior
                                </span>
                            <% } %>
                        </div>
                        
                        <div class="artist-details">
                            <div class="specialties">
                                <p class="details-label"><i class="fas fa-star"></i> Specialties</p>
                                <div class="specialty-tags">
                                    <% 
                                        const specialties = artist.role.split(',').map(s => s.trim());
                                        specialties.forEach(specialty => { 
                                    %>
                                        <span class="specialty-tag-small"><%= specialty %></span>
                                    <% }) %>
                                </div>
                            </div>
                            
                            <div class="artist-joined">
                                <i class="fas fa-calendar"></i>
                                Joined: <%= artist.createdAt ? new Date(artist.createdAt).toLocaleDateString() : new Date().toLocaleDateString() %>
                            </div>
                        </div>
                        
                        <div class="artist-actions">
                            <form action="/artists/<%= artist._id %>/delete" 
                                  method="POST" 
                                  class="delete-form">
                                <button type="submit" class="delete-btn" onclick="return confirm('Are you sure you want to remove <%= artist.name %>?')">
                                    <i class="fas fa-trash"></i> Remove
                                </button>
                            </form>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    <% } else { %>
        <!-- Empty State -->
        <div class="empty-state">
            <div class="empty-icon">
                <i class="fas fa-users-slash"></i>
            </div>
            <h3>No Artists Yet</h3>
            <p>Your studio team is empty. Add your first tattoo artist to get started.</p>
            <button class="add-first-btn" onclick="document.getElementById('artistForm').scrollIntoView({behavior: 'smooth'})">
                <i class="fas fa-user-plus"></i> Add First Artist
            </button>
        </div>
    <% } %>
    
    <!-- Tips Section -->
    <div class="tips-section">
        <div class="tips-header">
            <i class="fas fa-lightbulb"></i>
            <h3>Artist Management Tips</h3>
        </div>
        <div class="tips-grid">
            <div class="tip">
                <i class="fas fa-check-circle"></i>
                <h4>Clear Specialties</h4>
                <p>Be specific about each artist's main expertise</p>
            </div>
            <div class="tip">
                <i class="fas fa-check-circle"></i>
                <h4>Regular Updates</h4>
                <p>Keep artist profiles updated with their latest work</p>
            </div>
            <div class="tip">
                <i class="fas fa-check-circle"></i>
                <h4>Portfolio Links</h4>
                <p>Consider adding links to artist portfolios</p>
            </div>
        </div>
    </div>
</div>

